{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "installCommand": "node scripts/vercel-build.mjs --install-only",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?__route=/$1" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
