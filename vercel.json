{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "installCommand": "npm install --workspaces --include=dev",
  "buildCommand": "npm install --workspace @workspace/mockup-sandbox --include=dev && npm run build --workspace @workspace/mockup-sandbox",
  "outputDirectory": "artifacts/mockup-sandbox/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?__route=/$1" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
